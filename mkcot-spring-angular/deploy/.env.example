# Nakili:  cp .env.example .env   kisha jaza. USIWEKE .env KWENYE GITHUB.
# (setup-server.sh inatengeneza DB_PASSWORD na MKCOT_JWT_SECRET yenyewe.)

# Jina la tovuti linaloelekeza kwenye IP ya seva yako, mf:
#   mkcot.duckdns.org          (DuckDNS, bure)
#   140-238-10-20.sslip.io     (bure, bila kujisajili: IP yako kwa vistari + .sslip.io)
MKCOT_DOMAIN=

# Barua pepe yako: ndiyo pekee itakayokuwa Msimamizi wa kwanza, na Let's Encrypt itaitumia kwa taarifa za cheti
MKCOT_ADMIN_EMAIL=

# Neno la siri la database (herufi 24+ za nasibu):  openssl rand -hex 24
DB_PASSWORD=

# Ufunguo wa tokeni za kuingia (herufi 32+ za nasibu):  openssl rand -hex 32
MKCOT_JWT_SECRET=
