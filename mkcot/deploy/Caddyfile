# Caddy: HTTPS ya bure (Let's Encrypt) na vichwa vya usalama. Jina la tovuti linasomwa kwenye MKCOT_DOMAIN.
{
	email {$ACME_EMAIL}
}

{$MKCOT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
		-Server
	}

	# Search engines na programu za AI zinazuiwa (403). Orodha hii inalingana na robots.txt.
	@bots header_regexp User-Agent "(?i)(GPTBot|ChatGPT|OAI-SearchBot|ClaudeBot|Claude-Web|Claude-User|Claude-SearchBot|anthropic-ai|GoogleOther|Google-Extended|Googlebot|bingbot|Bingbot|Slurp|DuckDuckBot|Baiduspider|YandexBot|Applebot|CCBot|PerplexityBot|Perplexity-User|Bytespider|Amazonbot|meta-externalagent|meta-externalfetcher|FacebookBot|cohere-ai|cohere-training-data-crawler|MistralAI|DuckAssistBot|Diffbot|YouBot|Omgilibot|ImagesiftBot|Timpibot|AI2Bot|PetalBot|SemrushBot|AhrefsBot|MJ12bot|DataForSeoBot)"
	respond @bots 403

	# Ombi kubwa zaidi linaloruhusiwa (nakala ya JSON na nembo)
	request_body {
		max_size 6MB
	}

	# Caddy inaweka X-Forwarded-For yenye IP halisi ya mtumiaji
	reverse_proxy app:8080

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
